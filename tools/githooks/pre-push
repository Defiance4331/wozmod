#!/bin/sh
# Refuse to push any commit whose author or committer date is not in UTC, then run the default tests on
# exactly the commits being pushed, in a reused worktree, so other sessions' uncommitted edits play no part.
zero=0000000000000000000000000000000000000000
tips=
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  range=$local_sha; [ "$remote_sha" != "$zero" ] && range="$remote_sha..$local_sha"
  bad=$(git log --format='%h %ad %cd' --date=format:%z $range | awk '$2 != "+0000" || $3 != "+0000"')
  if [ -n "$bad" ]; then
    echo "pre-push: these commits are not in UTC; re-stamp them before pushing:" >&2
    echo "$bad" >&2
    exit 1
  fi
  tips="$tips $local_sha"
done
[ -n "$tips" ] || exit 0

top=$(git rev-parse --show-toplevel)
# With this machine's inputs configured, a test that skips for a missing input fails the push (tests/conftest.py).
main=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
strict=0; [ -f "$main/work/harness.toml" ] && strict=1
tree="$top/.worktrees/pre-push"  # kept between pushes, so its .venv and the native build are reused
[ -d "$tree" ] || git worktree add --detach -q "$tree" HEAD || exit 1
for sha in $tips; do
  echo "pre-push: testing $(git log -1 --format='%h %s' "$sha")" >&2
  (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE VIRTUAL_ENV
    cd "$tree" && git checkout --detach -q --force "$sha" && git clean -fdq &&
      WOZMOD_HARNESS_CONFIG="$main/work/harness.toml" WOZMOD_REQUIRE_INPUTS=$strict uv run -q --extra native pytest -q -p no:cacheprovider
  ) || { echo "pre-push: tests fail on $(git log -1 --format=%h "$sha"); push refused." >&2; exit 1; }
done
