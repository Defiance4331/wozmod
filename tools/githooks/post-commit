#!/bin/sh
# Re-stamp the commit just made in UTC, so commits never record the local timezone; then, in a linked worktree, start
# verifying it in the background (AGENTS.md, section Testing): tools/verify.py _background, detached, which stops
# this checkout's run of an older tree first. Also installed as post-merge. The re-stamp rebuilds HEAD with the same
# tree, parents, people and message.
if [ "$(git log -1 --format='%ad %cd' --date=format:%z)" != "+0000 +0000" ]; then
  old=$(git rev-parse HEAD)
  parents=$(git log -1 --format=%P | sed 's/[^ ][^ ]*/-p &/g')
  new=$(git cat-file commit HEAD | sed '1,/^$/d' |
    GIT_AUTHOR_NAME="$(git log -1 --format=%an)" GIT_AUTHOR_EMAIL="$(git log -1 --format=%ae)" \
    GIT_COMMITTER_NAME="$(git log -1 --format=%cn)" GIT_COMMITTER_EMAIL="$(git log -1 --format=%ce)" \
    GIT_AUTHOR_DATE="@$(git log -1 --format=%at) +0000" GIT_COMMITTER_DATE="@$(git log -1 --format=%ct) +0000" \
    git commit-tree "$(git rev-parse HEAD^{tree})" $parents) &&
  git update-ref -m "re-stamp in UTC" HEAD "$new" "$old" || exit 1
fi
# Not in the main checkout, which holds only what landed; nor from a commit inside a verify or test run, so no run
# starts another.
[ "$(git rev-parse --path-format=absolute --git-dir)" != "$(git rev-parse --path-format=absolute --git-common-dir)" ] ||
  exit 0
[ -z "$WOZMOD_VERIFY_JUDGE$PYTEST_CURRENT_TEST" ] || exit 0
python3 "$(dirname "$0")/../verify.py" _background </dev/null >/dev/null 2>&1 &
